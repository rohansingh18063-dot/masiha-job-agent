# Required: PostgreSQL connection string (free: neon.tech or supabase.com). Tables are created automatically.
DATABASE_URL=postgres://user:password@host:5432/masiha?sslmode=require

# Required: free key from https://aistudio.google.com (use a project WITHOUT billing so you never pay)
GEMINI_API_KEY=

# Required: password for /admin. At least 12 characters (Admin refuses shorter ones); 20 or more is best.
ADMIN_PASSWORD=

# Optional but recommended: free "I am human" check on sign-up (Cloudflare Turnstile, dash.cloudflare.com)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Payments (Razorpay: dashboard.razorpay.com → Account & Settings → API Keys; webhook under Webhooks).
# When both keys are set, the free plan is limited to one city and the ₹99 / ₹199 plans can be bought.
# Use rzp_test_ keys first: they take no real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shown on the Contact, Terms and Refund pages (Razorpay checks these before turning on live payments)
BUSINESS_NAME=
CONTACT_EMAIL=
CONTACT_PHONE=
BUSINESS_ADDRESS=

# Optional: shown on the privacy page (defaults to CONTACT_EMAIL)
PRIVACY_CONTACT_EMAIL=

# Optional: "Continue with Google" (see README → Sign in with Google). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Link back to the Masiha hub
NEXT_PUBLIC_HUB_URL=

# Optional
# TRUST_PROXY_HOPS=1     (proxies in front of the app, for the visitor's real IP; 0 if none)
# SIGNUPS_PER_DAY=1000   (new accounts per day across the whole site)
# UPLOAD_AI=off          (uploads use no Gemini: only the instant read, without jobs and education)
# DATABASE_POOL_SIZE=10
# GEMINI_MODEL=gemini-flash-latest
# DAILY_SEND_LIMIT=20
# DAILY_AI_LIMIT_PER_USER=40
# DAILY_AI_LIMIT_TOTAL=1000
# APP_URL=https://jobs.yourdomain.com
# MOCK_AI=1
